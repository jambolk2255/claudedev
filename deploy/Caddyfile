# Automatic HTTPS (Let's Encrypt) for the domain in deploy/.env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API straight to NestJS (real client IP for rate limiting); everything else to Next.js.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
