# Copy to deploy/.env (install.sh does this for you). Keep this file private: chmod 600 deploy/.env

# ── Address ─────────────────────────────────────────────────────────────────
# Your (sub)domain, without https://   e.g. mystock.duckdns.org or stock.mycompany.lk
DOMAIN=mystock.duckdns.org
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com
# DuckDNS (only if DOMAIN ends with .duckdns.org) — keeps the IP up to date
DUCKDNS_TOKEN=

# ── Secrets (install.sh generates these) ────────────────────────────────────
# openssl rand -hex 24  (letters and digits only — it goes into a URL)
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes-or-more
# openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── SaaS ────────────────────────────────────────────────────────────────────
SAAS_MODE=true
TRIAL_DAYS=14
TRIAL_PLAN=business
# Who can open the platform admin console (/admin). Register with this email first.
PLATFORM_ADMIN_EMAILS=you@example.com
# Shown to companies paying by bank transfer
BANK_TRANSFER_DETAILS="Account: Your Name | Bank: ... | Branch: ... | No: ..."

# ── PayHere (optional; leave empty to accept bank transfers only) ───────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
AUTH_RATE_LIMIT=10
