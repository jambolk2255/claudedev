{
  "name": "Agent X · daily backup (sample)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentx-backup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d1",
      "name": "Agent X webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "d1"
    },
    {
      "parameters": {
        "jsCode": "// Agent X sends the full backup JSON once a day. Store it (Google Drive, S3, disk…).\n// Tip: add a \"Convert to File\" node + \"Google Drive → Upload\" node after this one.\nconst backup = $input.first().json.body ?? {};\nreturn [{ json: { ok: true, tasks: (backup.tasks ?? []).length, exportedAt: backup.exportedAt } }];"
      },
      "id": "d2",
      "name": "Store backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "d3",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Agent X webhook": {
      "main": [
        [
          {
            "node": "Store backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store backup": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
