// StockFlow database schema.
// Every business table carries organizationId so the single-company MVP can
// become a multi-tenant SaaS without a data migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperienceMode {
  simple
  advanced
}

enum ValuationMethod {
  fifo
  weighted_average
}

model Organization {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  legalName             String?
  registrationNo        String?
  vatNo                 String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  country               String          @default("LK") @db.Char(2)
  logoUrl               String?
  industry              String?
  mode                  ExperienceMode  @default(simple)
  modules               String[]        @default(["inventory"])
  currency              String          @default("LKR") @db.Char(3)
  fiscalYearStartMonth  Int             @default(4)
  valuationMethod       ValuationMethod @default(weighted_average)
  allowNegativeStock    Boolean         @default(false)
  /// Days before expiry that batches are flagged.
  expiryAlertDays       Int             @default(30)
  /// Progress of the onboarding wizard: { currentStep, completedSteps, data }
  onboardingState       Json            @default("{}")
  onboardingCompletedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  users          User[]
  roles          Role[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  warehouses     Warehouse[]
  taxRates       TaxRate[]
  sequences      DocumentSequence[]
  categories     Category[]
  units          Unit[]
  products       Product[]
  partners       Partner[]
  batches        Batch[]
  stockLevels    StockLevel[]
  batchBalances  BatchBalance[]
  costLayers     CostLayer[]
  stockDocuments StockDocument[]
  stockMovements StockMovement[]
  orders         Order[]
  invoices       Invoice[]
  notes          Note[]
  payments       Payment[]
  allocations    Allocation[]
  accounts       Account[]
  journalEntries JournalEntry[]
  journalLines   JournalLine[]
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String
  roleId            String    @db.Uuid
  active            Boolean   @default(true)
  locale            String    @default("en")
  /// AES-256-GCM encrypted TOTP secret
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id])
  sessions        Session[]
  auditLogs       AuditLog[]
  stockDocuments  StockDocument[] @relation("DocumentCreatedBy")
  movements       StockMovement[]
  invitationsSent Invitation[]    @relation("InvitedBy")

  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// Stable key for system roles (owner, admin, ...). Null for custom roles.
  key            String?
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
}

/// One row per issued refresh token. Rotation links tokens of a login into a family;
/// presenting an already-rotated token revokes the whole family (reuse detection).
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  roleId         String    @db.Uuid
  tokenHash      String    @unique
  invitedById    String?   @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entity, entityId])
}

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  address        String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels   StockLevel[]
  batchBalances BatchBalance[]
  movements     StockMovement[]
  documents     StockDocument[] @relation("DocumentWarehouse")
  incoming      StockDocument[] @relation("DocumentToWarehouse")
  Order         Order[]

  @@unique([organizationId, code])
}

model TaxRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  rate           Decimal  @db.Decimal(6, 3)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
}

model DocumentSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  type           String
  prefix         String
  includeYear    Boolean  @default(true)
  padding        Int      @default(5)
  nextNumber     Int      @default(1)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, name])
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
}

// ─── Phase 1: master data & inventory ──────────────────────────────────────────

enum ProductType {
  stock
  service
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  sku            String
  name           String
  description    String?
  barcode        String?
  type           ProductType @default(stock)
  categoryId     String?     @db.Uuid
  unitId         String?     @db.Uuid
  taxRateId      String?     @db.Uuid
  costPrice      Decimal     @default(0) @db.Decimal(18, 4)
  sellPrice      Decimal     @default(0) @db.Decimal(18, 4)
  reorderLevel   Decimal?    @db.Decimal(18, 4)
  maxLevel       Decimal?    @db.Decimal(18, 4)
  trackBatches   Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit         Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  taxRate      TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  levels       StockLevel[]
  batches      Batch[]
  movements    StockMovement[]
  costLayers   CostLayer[]
  lines        StockDocumentLine[]
  orderLines   OrderLine[]
  invoiceLines InvoiceLine[]
  noteLines    NoteLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, barcode])
}

enum PartnerType {
  customer
  supplier
}

/// Customers and suppliers share one table; `type` tells them apart.
model Partner {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @db.Uuid
  type             PartnerType
  code             String
  name             String
  contactName      String?
  email            String?
  phone            String?
  taxNo            String?
  address          String?
  city             String?
  latitude         Decimal?    @db.Decimal(9, 6)
  longitude        Decimal?    @db.Decimal(9, 6)
  creditLimit      Decimal?    @db.Decimal(18, 2)
  paymentTermsDays Int         @default(0)
  notes            String?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents        StockDocument[]
  orders           Order[]
  invoices         Invoice[]
  creditDebitNotes Note[]
  payments         Payment[]
  journalLines     JournalLine[]

  @@unique([organizationId, type, code])
  @@index([organizationId, type, name])
}

model Batch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  productId      String    @db.Uuid
  batchNo        String
  expiryDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances     BatchBalance[]
  movements    StockMovement[]

  @@unique([productId, batchNo])
  @@index([organizationId, expiryDate])
}

/// Cached on-hand quantity per product and warehouse. Only the inventory service writes it,
/// always together with a StockMovement row.
model StockLevel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  warehouseId    String   @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(18, 4)
  /// Weighted average unit cost (also kept up to date under FIFO for reporting).
  avgCost        Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([organizationId, warehouseId])
}

model BatchBalance {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  batchId        String  @db.Uuid
  warehouseId    String  @db.Uuid
  quantity       Decimal @default(0) @db.Decimal(18, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([batchId, warehouseId])
}

/// FIFO cost layers: each receipt adds a layer, issues consume the oldest first.
model CostLayer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  warehouseId    String   @db.Uuid
  unitCost       Decimal  @db.Decimal(18, 4)
  originalQty    Decimal  @db.Decimal(18, 4)
  remainingQty   Decimal  @db.Decimal(18, 4)
  receivedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, warehouseId, receivedAt])
}

enum StockDocumentType {
  opening
  stock_in
  stock_out
  adjustment
  count
  transfer
  grn
  delivery
  return_outward
  return_inward
}

enum StockDocumentStatus {
  posted
  in_transit
  received
}

model StockDocument {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  type           StockDocumentType
  status         StockDocumentStatus @default(posted)
  number         String
  warehouseId    String              @db.Uuid
  toWarehouseId  String?             @db.Uuid
  partnerId      String?             @db.Uuid
  orderId        String?             @db.Uuid
  reference      String?
  reason         String?
  note           String?
  documentDate   DateTime            @db.Date
  totalValue     Decimal             @default(0) @db.Decimal(18, 4)
  createdById    String?             @db.Uuid
  receivedById   String?             @db.Uuid
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse           @relation("DocumentWarehouse", fields: [warehouseId], references: [id])
  toWarehouse     Warehouse?          @relation("DocumentToWarehouse", fields: [toWarehouseId], references: [id])
  partner         Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines           StockDocumentLine[]
  movements       StockMovement[]
  creditDebitNote Note?

  @@unique([organizationId, number])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([orderId])
}

model StockDocumentLine {
  id             String    @id @default(uuid()) @db.Uuid
  documentId     String    @db.Uuid
  lineNo         Int
  productId      String    @db.Uuid
  /// Quantity moved. For stock counts this is the counted quantity.
  quantity       Decimal   @db.Decimal(18, 4)
  orderLineId    String?   @db.Uuid
  /// For stock counts: on-hand quantity when the count was posted.
  systemQuantity Decimal?  @db.Decimal(18, 4)
  unitCost       Decimal?  @db.Decimal(18, 4)
  batchNo        String?
  expiryDate     DateTime? @db.Date
  note           String?

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([documentId])
}

enum StockMovementType {
  opening
  stock_in
  stock_out
  adjustment_in
  adjustment_out
  transfer_out
  transfer_in
  purchase_in
  sale_out
  return_out
  return_in
}

/// Immutable stock ledger. Rows are only ever inserted.
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  batchId        String?           @db.Uuid
  documentId     String?           @db.Uuid
  type           StockMovementType
  /// Signed: positive increases stock, negative decreases it.
  quantity       Decimal           @db.Decimal(18, 4)
  unitCost       Decimal           @db.Decimal(18, 4)
  /// Signed value of the movement (quantity × cost).
  totalCost      Decimal           @db.Decimal(18, 4)
  balanceAfter   Decimal           @db.Decimal(18, 4)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  batch        Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  document     StockDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, productId, createdAt(sort: Desc)])
  @@index([organizationId, warehouseId, createdAt(sort: Desc)])
}

// ─── Phase 2-4: orders, invoices, notes, payments and the general ledger ───────

enum OrderKind {
  purchase
  quotation
  sales
}

enum OrderStatus {
  draft
  confirmed
  partial
  fulfilled
  closed
  cancelled
}

/// Purchase orders, quotations and sales orders share one structure.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  kind            OrderKind
  number          String
  partnerId       String      @db.Uuid
  warehouseId     String      @db.Uuid
  status          OrderStatus @default(draft)
  orderDate       DateTime    @db.Date
  expectedDate    DateTime?   @db.Date
  reference       String?
  notes           String?
  deliveryAddress String?
  subtotal        Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(18, 2)
  ssclTotal       Decimal     @default(0) @db.Decimal(18, 2)
  total           Decimal     @default(0) @db.Decimal(18, 2)
  approvedById    String?     @db.Uuid
  approvedAt      DateTime?
  convertedFromId String?     @db.Uuid
  /// Random token for the public order-tracking page (sales orders only).
  trackingToken   String?     @unique
  createdById     String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner        Partner         @relation(fields: [partnerId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  convertedFrom  Order?          @relation("OrderConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo    Order[]         @relation("OrderConversion")
  lines          OrderLine[]
  stockDocuments StockDocument[]
  invoices       Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, kind, status])
  @@index([organizationId, partnerId])
}

model OrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @db.Uuid
  lineNo       Int
  productId    String  @db.Uuid
  description  String?
  quantity     Decimal @db.Decimal(18, 4)
  /// Received (purchase) or delivered (sales) quantity.
  fulfilledQty Decimal @default(0) @db.Decimal(18, 4)
  invoicedQty  Decimal @default(0) @db.Decimal(18, 4)
  unitPrice    Decimal @db.Decimal(18, 4)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  taxRateId    String? @db.Uuid
  /// Tax percentage snapshot at the time of the order.
  taxRate      Decimal @default(0) @db.Decimal(6, 3)
  subtotal     Decimal @db.Decimal(18, 2)
  tax          Decimal @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum InvoiceKind {
  sales
  purchase
}

enum InvoiceStatus {
  open
  partially_paid
  paid
  void
}

/// Sales invoices and supplier bills.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  kind           InvoiceKind
  number         String
  partnerId      String        @db.Uuid
  orderId        String?       @db.Uuid
  invoiceDate    DateTime      @db.Date
  dueDate        DateTime      @db.Date
  /// Supplier's own invoice number (bills).
  supplierRef    String?
  status         InvoiceStatus @default(open)
  subtotal       Decimal       @db.Decimal(18, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal       @db.Decimal(18, 2)
  ssclTotal      Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  /// Payments and notes applied so far.
  amountPaid     Decimal       @default(0) @db.Decimal(18, 2)
  notes          String?
  journalEntryId String?       @db.Uuid
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner      Partner       @relation(fields: [partnerId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  allocations  Allocation[]
  notesIssued  Note[]

  @@unique([organizationId, number])
  @@index([organizationId, kind, status])
  @@index([organizationId, partnerId])
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  lineNo      Int
  productId   String?  @db.Uuid
  orderLineId String?  @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRateId   String?  @db.Uuid
  taxRate     Decimal  @default(0) @db.Decimal(6, 3)
  subtotal    Decimal  @db.Decimal(18, 2)
  tax         Decimal  @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  /// Bills: goods-received value cleared from GRNI for this line.
  costAmount  Decimal? @db.Decimal(18, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

enum NoteKind {
  credit
  debit
}

enum NoteStatus {
  open
  applied
}

/// Credit notes (customer returns) and debit notes (returns to suppliers).
model Note {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  kind            NoteKind
  number          String
  partnerId       String     @db.Uuid
  invoiceId       String?    @db.Uuid
  stockDocumentId String?    @unique @db.Uuid
  noteDate        DateTime   @db.Date
  reason          String?
  subtotal        Decimal    @db.Decimal(18, 2)
  taxTotal        Decimal    @db.Decimal(18, 2)
  ssclTotal       Decimal    @default(0) @db.Decimal(18, 2)
  total           Decimal    @db.Decimal(18, 2)
  amountApplied   Decimal    @default(0) @db.Decimal(18, 2)
  status          NoteStatus @default(open)
  journalEntryId  String?    @db.Uuid
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner       Partner        @relation(fields: [partnerId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  stockDocument StockDocument? @relation(fields: [stockDocumentId], references: [id], onDelete: SetNull)
  lines         NoteLine[]
  allocations   Allocation[]

  @@unique([organizationId, number])
  @@index([organizationId, kind, status])
}

model NoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  noteId      String  @db.Uuid
  lineNo      Int
  productId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(6, 3)
  subtotal    Decimal @db.Decimal(18, 2)
  tax         Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  note    Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([noteId])
}

enum PaymentKind {
  receipt
  payment
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  card
}

enum PaymentStatus {
  posted
  bounced
}

enum ChequeStatus {
  pending
  cleared
  bounced
}

/// Customer receipts and supplier payments.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  kind            PaymentKind
  number          String
  partnerId       String        @db.Uuid
  paymentDate     DateTime      @db.Date
  method          PaymentMethod
  accountId       String        @db.Uuid
  amount          Decimal       @db.Decimal(18, 2)
  amountAllocated Decimal       @default(0) @db.Decimal(18, 2)
  status          PaymentStatus @default(posted)
  reference       String?
  chequeNo        String?
  chequeDate      DateTime?     @db.Date
  chequeStatus    ChequeStatus?
  notes           String?
  journalEntryId  String?       @db.Uuid
  createdById     String?       @db.Uuid
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner      Partner      @relation(fields: [partnerId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  allocations  Allocation[]

  @@unique([organizationId, number])
  @@index([organizationId, kind, paymentDate])
  @@index([organizationId, partnerId])
}

/// Applies a payment or a note to an invoice.
model Allocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  invoiceId      String   @db.Uuid
  paymentId      String?  @db.Uuid
  noteId         String?  @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  note         Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentId])
  @@index([noteId])
}

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  code           String
  name           String
  type           AccountType
  /// Stable key for accounts the system posts to automatically.
  systemKey      String?
  /// Cash and bank accounts can receive and make payments.
  isCash         Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]
  payments     Payment[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

/// Double-entry general ledger. Entries are append-only; corrections are reversing entries.
model JournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  number         String
  entryDate      DateTime @db.Date
  sourceType     String
  sourceId       String?  @db.Uuid
  memo           String?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalLine[]

  @@unique([organizationId, number])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
}

model JournalLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  entryId        String  @db.Uuid
  accountId      String  @db.Uuid
  partnerId      String? @db.Uuid
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  memo           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])

  @@index([organizationId, accountId])
  @@index([organizationId, partnerId])
  @@index([entryId])
}
