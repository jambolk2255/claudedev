// StockFlow database schema.
// Every business table carries organizationId so the single-company MVP can
// become a multi-tenant SaaS without a data migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperienceMode {
  simple
  advanced
}

enum ValuationMethod {
  fifo
  weighted_average
}

model Organization {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  legalName             String?
  registrationNo        String?
  vatNo                 String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  country               String          @default("LK") @db.Char(2)
  logoUrl               String?
  industry              String?
  mode                  ExperienceMode  @default(simple)
  modules               String[]        @default(["inventory"])
  currency              String          @default("LKR") @db.Char(3)
  fiscalYearStartMonth  Int             @default(4)
  valuationMethod       ValuationMethod @default(weighted_average)
  allowNegativeStock    Boolean         @default(false)
  /// Progress of the onboarding wizard: { currentStep, completedSteps, data }
  onboardingState       Json            @default("{}")
  onboardingCompletedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  users        User[]
  roles        Role[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  warehouses   Warehouse[]
  taxRates     TaxRate[]
  sequences    DocumentSequence[]
  categories   Category[]
  units        Unit[]
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  roleId           String    @db.Uuid
  active           Boolean   @default(true)
  locale           String    @default("en")
  /// AES-256-GCM encrypted TOTP secret
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  passwordChangedAt DateTime @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  invitationsSent Invitation[] @relation("InvitedBy")

  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// Stable key for system roles (owner, admin, ...). Null for custom roles.
  key            String?
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  invitations  Invitation[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
}

/// One row per issued refresh token. Rotation links tokens of a login into a family;
/// presenting an already-rotated token revokes the whole family (reuse detection).
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  roleId         String    @db.Uuid
  tokenHash      String    @unique
  invitedById    String?   @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entity, entityId])
}

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  address        String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model TaxRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  rate           Decimal  @db.Decimal(6, 3)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model DocumentSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  type           String
  prefix         String
  includeYear    Boolean  @default(true)
  padding        Int      @default(5)
  nextNumber     Int      @default(1)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")

  @@unique([organizationId, name])
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}
