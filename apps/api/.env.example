NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public
REDIS_URL=redis://localhost:6379
# Comma separated list of origins allowed to call the API directly (the web app proxies /api)
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10

# ─── SaaS (optional) ─────────────────────────────────────────────────────────
# SAAS_MODE=true opens self sign-up with a free trial, plan limits and billing.
SAAS_MODE=false
TRIAL_DAYS=14
TRIAL_PLAN=business
# Who can open the platform admin console (/admin)
PLATFORM_ADMIN_EMAILS=
# PayHere (https://www.payhere.lk) — leave empty to accept bank transfers only
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Public URL for PayHere's server-to-server notification (defaults to WEB_URL)
# API_PUBLIC_URL=https://stock.example.lk
BANK_TRANSFER_DETAILS="Account: StockFlow (Pvt) Ltd | Bank: Commercial Bank | Branch: Colombo | No: 1234567890"
