{
  "name": "@stockflow/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.16.2",
    "@stockflow/schemas": "workspace:*",
    "argon2": "0.44.0",
    "fastify": "5.4.0",
    "otplib": "12.0.1",
    "prisma": "6.16.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@nestjs/cli": "11.0.10",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
